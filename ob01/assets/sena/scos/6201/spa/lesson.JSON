data": [{"contents": [{"content": "", "type": "text"}], "type": "question"}], "responses": [{"correct": 0, "selected": 0, "_data": [{"content": "", "type": "text"}], "id": 0}, {"correct": 1, "selected": 0, "_data": [{"content": "", "type": "text"}], "id": 1}], "id": 0}], "template_override": 1, "stimuli_ids": [], "_data": [{"contents": [], "type": "instructions"}, {"contents": [{"content": "Quiz", "type": "group_name"}], "type": "group"}, {"content": {"correct_feedback": "Correct!", "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "allowed_attempts": 2, "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}], "id": 11, "type": "RSLT"}], "_data": [{"contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}], "type": "lab_options"}], "type": "scholar", "id": 0, "stimuli": [{"type": "welcome", "_data": [], "template_override": 1, "contents": [{}], "id": 0}, {"template_override": 1, "title": "", "contents": [{"type": "slideshow", "value": {"coverimg": "engenn8le05ob01re2img05.jpg", "audiosrc": "engenn8le05ob01re2aud01", "images": [{"time": "0", "image": "engenn8le05ob01re2img05.jpg", "id": 0, "text": ""}, {"time": "100", "image": "engenn8le05ob01re2img05.jpg", "id": 1, "text": "<span class=\"strong\">Jose</span>: \t\t\tHola, Miss ... ?<br/>\n<span class=\"strong\">Vanessa</span>:\t\tI'm Vanessa. You must be Jose! I'm glad to finally meet you.<br/>\n<span class=\"strong\">Jose</span>:\t\t\tIt is my pleasure to meet you too. Thank you for meeting me. I'm excited to start working in your restaurant. I didn't expect to get a job so fast.<br/>\n<span class=\"strong\">Vanessa</span>:\t\tHiring the right people isn't easy, but I had a good feeling about your application. Judging from your CV, you seem to possess a strong work ethic."}, {"time": "24000", "image": "engenn8le05ob01re2img01.jpg", "id": 2, "text": "<span class=\"strong\">Jose</span>:\t\t\tThank you. I hope I have what it takes to become a member of your team. <br/>\n<span class=\"strong\">Vanessa</span>:\t\tI'm sure you will. How long have you been in Cambridge?<br/>\n<span class=\"strong\">Jose</span>:\t\t\tI arrived a few weeks ago. Traveling in the winter is very cold!<br/>\n<span class=\"strong\">Vanessa</span>:\t\tWere you surprised to see so much snow when you got here?<br/>\n<span class=\"strong\">Jose</span>:\t\t\tNot really. I read up on Boston's winters to prepare myself! I wanted to know what kind of adjustments I would need to make to my life here.<br/>\n<span class=\"strong\">Vanessa</span>:\t\tThat was probably a good idea. Our summers make up for the cold, though. You'll see."}, {"time": "53000", "image": "engenn8le05ob01re2img02.jpg", "id": 3, "text": "<span class=\"strong\">Jose</span>:\t\t\tThat sounds good! My favorite hobbies are swimming and jogging.<br/>\n<span class=\"strong\">Vanessa</span>:\t\tFantastic! Now, let me show you around. I want to see to it that you understand how everything works. Making sure that my staff are the best in town is something I take seriously.   <br/>\n<span class=\"strong\">Jose</span>:\t\t\tI understand. I'll keep at it.<br/>\n<span class=\"strong\">Vanessa</span>:\t\tI'm sure you will. Now, if you'll excuse me, I need to carry on with today's tasks ..."}]}}], "_data": [], "id": 1, "type": "audio"}]}], "type": "sena"}