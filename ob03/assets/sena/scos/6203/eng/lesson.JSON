": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}, {"type": "post_instructions", "contents": [{"content": "\nInstructions: Click on the correct word to complete the sentence. \n", "type": "text"}]}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}]}], "id": 10, "stimuli_ids": []}, {"template_override": 1, "type": "RSLT", "questions": [{"responses": [{"correct": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "id": 0}, {"correct": 1, "_data": [{"content": "", "type": "text"}], "selected": 0, "id": 1}], "_data": [{"type": "question", "contents": [{"content": "", "type": "text"}]}], "id": 0}], "_data": [{"type": "instructions", "contents": []}, {"type": "group", "contents": [{"content": "Quiz", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": []}], "id": 11, "stimuli_ids": []}], "type": "scholar", "stimuli": [{"template_override": 1, "type": "welcome", "_data": [], "contents": [{}], "id": 0}, {"template_override": 1, "type": "audio", "id": 1, "title": "", "contents": [{"type": "slideshow", "value": {"audiosrc": "engenn8le05ob03re2aud01", "coverimg": "engenn8le05ob03re2img05.jpg", "images": [{"image": "engenn8le05ob03re2img05.jpg", "text": "", "time": "0", "id": 0}, {"image": "engenn8le05ob03re2img05.jpg", "text": "<span class=\"strong\">Vanessa</span>:\tJose, I think your training is coming along quite well. However, as a new trainee, you should spend some time hanging around with one of the more senior waiters.<br/>\n<span class=\"strong\">Jose</span>:\t\tI think it's a good idea. I hope they won't look down on me, though.<br/>\n<span class=\"strong\">Vanessa</span>:\tWhy would they? They are all in the service industry for a reason. They're supposed to uphold certain standards of excellence. Sharing information with their new colleagues is something they're supposed to do. I'll introduce you to Frank, one of our Maitre d's. He's our best employee. You should learn a lot from him.", "time": "100", "id": 1}, {"image": "engenn8le05ob03re2img02.jpg", "text": "<span class=\"strong\">Jose</span>:\t\tI am sure I will. I had a mentor in Colombia, too. I really looked up to him as well. For example, he gave me pointers on how to put up with difficult customers in any situation.<br/>\n<span class=\"strong\">Vanessa</span>:\tI know all about difficult customers and picky eaters, trust me. You know what we say in English, right?<br/>\n<span class=\"strong\">Jose</span>:\t\tHmm ... The customer is almost right?", "time": "31000", "id": 2}, {"image": "engenn8le05ob03re2img01.jpg", "text": "<span class=\"strong\">Vanessa</span>:  Always, not almost. You're supposed to keep smiling even when you have to deal with terrible patrons. Obviously, you shouldn't talk back either.<br/>\n<span class=\"strong\">Jose</span>:\t\tOf course not! That's a big no-no in Colombia, too. <br/>\n<span class=\"strong\">Vanessa</span>:\tGreat. I'm supposed to deal with some suppliers on the phone. I'll leave you with Frank. His service is impeccable yet unobtrusive.", "time": "52000", "id": 3}]}}], "_data": []}], "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}], "id": 0}], "type": "sena"}