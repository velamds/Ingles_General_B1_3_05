ect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "allowed_attempts": 2, "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}, {"contents": [], "type": "learning_skills"}], "id": 11, "type": "RSLT"}], "_data": [{"contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}], "type": "lab_options"}], "type": "scholar", "id": 0, "stimuli": [{"type": "welcome", "_data": [], "template_override": 1, "contents": [{}], "id": 0}, {"template_override": 1, "title": "", "contents": [{"type": "slideshow", "value": {"coverimg": "engenn8le05ob03re2img05.jpg", "audiosrc": "engenn8le05ob03re2aud01", "images": [{"time": "0", "image": "engenn8le05ob03re2img05.jpg", "id": 0, "text": ""}, {"time": "100", "image": "engenn8le05ob03re2img05.jpg", "id": 1, "text": "<span class=\"strong\">Vanessa</span>:\tJose, I think your training is coming along quite well. However, as a new trainee, you should spend some time hanging around with one of the more senior waiters.<br/>\n<span class=\"strong\">Jose</span>:\t\tI think it's a good idea. I hope they won't look down on me, though.<br/>\n<span class=\"strong\">Vanessa</span>:\tWhy would they? They are all in the service industry for a reason. They're supposed to uphold certain standards of excellence. Sharing information with their new colleagues is something they're supposed to do. I'll introduce you to Frank, one of our Maitre d's. He's our best employee. You should learn a lot from him."}, {"time": "31000", "image": "engenn8le05ob03re2img02.jpg", "id": 2, "text": "<span class=\"strong\">Jose</span>:\t\tI'm sure I will. I had a mentor in Colombia, too. I really looked up to him as well. For example, he gave me pointers on how to put up with difficult customers in any situation.<br/>\n<span class=\"strong\">Vanessa</span>:\tI know all about difficult customers and picky eaters, trust me. You know what we say in English, right?<br/>\n<span class=\"strong\">Jose</span>:\t\tHmm ... The customer is almost right?"}, {"time": "52000", "image": "engenn8le05ob03re2img01.jpg", "id": 3, "text": "<span class=\"strong\">Vanessa</span>:  Always, not almost. You're supposed to keep smiling even when you have to deal with terrible patrons. Obviously, you shouldn't talk back either.<br/>\n<span class=\"strong\">Jose</span>:\t\tOf course not! That's a big no-no in Colombia, too. <br/>\n<span class=\"strong\">Vanessa</span>:\tGreat. I'm supposed to deal with some suppliers on the phone. I'll leave you with Frank. His service is impeccable yet unobtrusive."}]}}], "_data": [], "id": 1, "type": "audio"}]}], "type": "sena"}