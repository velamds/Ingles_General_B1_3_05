 {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}]}], "id": 9, "stimuli_ids": []}, {"template_override": 1, "type": "RSLT", "questions": [{"responses": [{"id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 0}, {"id": 1, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 1}], "_data": [{"type": "question", "contents": [{"content": "", "type": "text"}]}], "id": 0}], "_data": [{"type": "instructions", "contents": []}, {"type": "group", "contents": [{"content": "Quiz", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}], "id": 10, "stimuli_ids": []}, {"template_override": 1, "type": "DWS", "questions": [{"responses": [{"id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 1}], "_data": [{"type": "question", "contents": [{"content": "engenn8le05ob07re7pdf01.pdf", "type": "pdf"}]}], "id": 0}], "_data": [{"type": "instructions", "contents": [{"content": "Write about  your favorite holiday/festival in your country.", "type": "text"}]}, {"type": "group", "contents": [{"content": "Take Away", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Writing", "type": "skill"}, {"content": "Listening", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "Instructions: Complete the following steps. Fill in the Self-Assessment.", "type": "text"}]}], "id": 11, "stimuli_ids": []}], "stimuli": [{"template_override": 1, "_data": [], "type": "welcome", "contents": [{}], "id": 0}, {"template_override": 1, "_data": [], "type": "audio", "title": "", "contents": [{"type": "slideshow", "value": {"audiosrc": "engenn8le05ob07re2aud01", "coverimg": "engenn8le05ob07re2img01.jpg", "images": [{"image": "engenn8le05ob07re2img01.jpg", "text": "", "id": 0, "time": "0"}, {"image": "engenn8le05ob07re2img01.jpg", "text": "<span class=\"strong\">Jose</span>:\t\tHow was that shepherd's pie?<br/>\n<span class=\"strong\">Jessica</span>:\tIt was delicious. Thanks for the suggestion.\tI shouldn't eat this every week, though! It's better not to worry about that, right?<br/>\n<span class=\"strong\">Jose</span>:\t\tExactly! Just enjoy life. That's what we do in Colombia. <br/>\n<span class=\"strong\">Jessica</span>:\tI heard there are a lot of festivals and celebrations.", "id": 1, "time": "100"}, {"image": "engenn8le05ob07re2img02.jpg", "text": "<span class=\"strong\">Jose</span>:\t\tOh yes! They are not to be missed. You can start with the Black and White Festival in January.<br/>\n<span class=\"strong\">Jessica</span>:\tWhat is that? I'm not sure I've heard about it.<br/>\n<span class=\"strong\">Jose</span>:\t\tIt's a 3-day carnival held in the city of Pasto, in southeastern Colombia. It showcases a mixture of indigenous rituals and Spanish colonial traditions. On the last day, the revelers paint each other black and large quantities of white talcum powder are thrown all over the city.<br/>\n<span class=\"strong\">Jessica</span>:\tThat sounds fun!<br/>\n<span class=\"strong\">Jose</span>:\t\tYou should really see it. It\u2018s not something you experience every day.", "id": 2, "time": "15000"}, {"image": "engenn8le05ob07re2img03.jpg", "text": "<span class=\"strong\">Jessica</span>:\tI also heard there were a lot of religious processions.<br/>\n<span class=\"strong\">Jose</span>:\t\tYes, of course. The Catholic influence is still very strong in Colombia. It is part of our ancestry. Our Easter celebrations are very traditional. We're supposed to think about the religious meaning of Easter. We don't have the bunny like you do here!<br/>\n<span class=\"strong\">Jessica</span>:\tVery funny. <br/>\n<span class=\"strong\">Jose</span>:\t\tWe also take our beauty pageants seriously. For example, we crown a Queen of Coffee every year during the Manizales Festival in January.<br/>\n<span class=\"strong\">Jessica</span>: \tWell, we certainly do not have that in Boston ...", "id": 3, "time": "44000"}]}}], "id": 1}], "type": "scholar", "id": 0, "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}]}], "_data": [{"type": "metadata", "contents": [{"content": "The New Waiter", "type": "lesson_name"}, {"content": "Colombian Traditions", "type": "unit_name"}, {"content": 7, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 5, "type": "lesson"}, {"content": "B1.3", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "Accurately use information about people's backgrounds in a wider variety of communicative situations.", "type": "primary"}, {"content": " Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_1"}, {"content": " Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_2"}, {"content": " Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_3"}, {"content": " Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_4"}, {"content": " Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_5"}, {"content": " Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_6"}, {"content": " Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_7"}, {"content": " Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_8"}]}, {"content": "engenn8le05ob07re1img01.jpg", "type": "background_image"}, {"type": "learning_points", "contents": [{"content": " The Position of Not", "type": "heading"}, {"content": "In English, the adverb  <span class=\"italic\">not</span> usually goes after the auxiliary verb or \u201cbe\u201d to form the negative. <br/><br/> You can use the adverb not in other positions in some cases.", "type": "describer"}, {"content": "Usually, we find the adverb not in conjunction with an auxiliary verb or \u201cbe\u201d in a negative sentence.", "type": "text"}, {"content": "Example:<br/>  <span class=\"italic\">Well, we certainly do <span class=\"strong\">not</span> have that in Boston<br/> I'm <span class=\"strong\">not</span> sure I heard about it.<br/> I shouldn't eat this every week = I should <span class=\"strong\">not</span> eat this every week.</span>", "type": "text"}, {"content": "When you use the long form instead of the contraction, you emphasize the negation of the verb.", "type": "text"}, {"content": " You also find <span class=\"italic\">not</span> <span class=\"strong\">before</span> a verb in the Infinitive.", "type": "text"}, {"content": "  Example:<br/>  <span class=\"italic\">They are  <span class=\"strong\">not</span> to be missed. <br/> It's better  <span class=\"strong\">not</span> to think about it, right?</span>", "type": "text"}]}, {"type": "learning_points", "contents": [{"content": " Should and Be Supposed To ", "type": "heading"}, {"content": "You use the modal  <span class=\"strong\">should</span> or the  structure  <span class=\"strong\">be supposed to</span> when you want to talk about expectations, obligations or arrangements.", "type": "describer"}, {"content": "You can use  <span class=\"strong\">be supposed to</span> to talk about situations in the present or future that are expected to happen. <br/><br/> The structure is:<br/><br/>  Subject + To be + supposed to + verb<br/><br/>  <span class=\"italic\">Sharing information with their new colleagues is something they're <span class=\"strong\">supposed to do</span> .</span> <br/><br/>  **Pronunciation tip**:<br/> When you say be supposed to, you link the /d/ and /t/ sounds together.  <br/><br/> Like this:<br/> Be suppose_to", "type": "text"}, {"content": "We are supposed to think about the religious meaning of Easter. ", "type": "example"}, {"content": "You should really see the festival. It is not something you experience every day.", "type": "example"}]}, {"type": "target_word", "contents": [{"content": "pageant", "type": "name"}, {"content": "an elaborate performance featuring colorful costumes; beauty contest", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: We take our beauty pageants very seriously.", "type": "example"}, {"content": "engenn8le05ob07aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": " These are words you hear in a conversation about traditions.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "procession", "type": "name"}, {"content": "a number of people and vehicles moving together as part of a ceremony", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: There are a lot of religious processions in my country.", "type": "example"}, {"content": "engenn8le05ob07aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "ritual", "type": "name"}, {"content": "a ceremony consisting of a series of actions performed according to a prescribed order", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Does your family have any New Year's rituals?", "type": "example"}, {"content": "engenn8le05ob07aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "ancestry", "type": "name"}, {"content": "a person's family or ethnic descent", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: My ancestry is German, Irish and a little French.", "type": "example"}, {"content": "engenn8le05ob07aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "influence", "type": "name"}, {"content": "a person or thing that has an effect on your life", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: The Catholic influence is still very strong in Colombia.", "type": "example"}, {"content": "engenn8le05ob07aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "indigenous", "type": "name"}, {"content": "where something is from; where something grows naturally", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: The kangaroo is indigenous to Australia.", "type": "example"}, {"content": "engenn8le05ob07aud06", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "reveler", "type": "name"}, {"content": "a party goer", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: On the last day, the revelers paint each other black.", "type": "example"}, {"content": "engenn8le05ob07aud07", "type": "audio"}]}, {"type": "takeaway_extension", "contents": [{"content": "Pick your favorite holiday or festival from your country.", "type": "text"}, {"content": "Answer five questions about your selection: What does the holiday mean? When is it? What do people usually do? Is there any special food? Is it a day off?", "type": "text"}, {"content": "Write out your answers.", "type": "text"}, {"content": "Have your partner ask you the questions.", "type": "text"}, {"content": "Answer the questions without reading from your  written answers.", "type": "text"}, {"content": "Switch roles.", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I practice asking questions.", "type": "text"}, {"content": "I  talk about cultural items, icons and events.  ", "type": "text"}, {"content": "I explain my opinion. ", "type": "text"}]}]}